    public function store(Request $request)
{
    $request->validate([
        'valor' => 'required|numeric',
        'qtd_parcelas' => 'required|integer|min:1',
        'intervalo_dias' => 'required|integer|min:0',
        'cliente_id' => 'required|exists:clientes,id', // Ensure cliente_id is provided and valid
        'data_inicio' => 'required|date', // Ensure data_inicio is provided and valid
    ]);

    // Create the contract
    $contrato = Contrato::create($request->all());

    // Calculate the value of each installment
    $valorParcela = $contrato->valor / $contrato->qtd_parcelas;
    $dataVencimento = Carbon::parse($contrato->data_inicio);

    // Create the installments
    for ($i = 1; $i <= $contrato->qtd_parcelas; $i++) {
        Parcela::create([
            'contrato_id' => $contrato->id,
            'numero' => $i,
            'data_vencimento' => $dataVencimento->copy()->addDays($contrato->intervalo_dias * ($i - 1)),
            'valor' => $valorParcela,
            'paga' => false,
        ]);
    }

    return redirect()->route('contratos.index')->with('success', 'Contrato e parcelas criadas com sucesso!');
}
    

