    public function show($id)
    {
        $contrato = Contrato::with('parcelas')->findOrFail($id);

        $contrato->total_receber = $contrato->valor * (1 + ($contrato->juros / 100));
        $contrato->lucro = $contrato->total_receber - $contrato->valor;
        $contrato->total_receber = $contrato->valor * (1 + ($contrato->juros / 100));

        return view('contratos.show', compact('contrato'));
    }
    


