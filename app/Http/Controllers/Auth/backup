public function update(Request $request, Contrato $contrato)
{
    $request->validate([
        'data_inicio' => 'required|date',
        'cliente_id' => 'required|exists:clientes,id',
        'valor' => 'required|numeric|min:0',
        'qtd_parcelas' => 'required|integer|min:1',
        'intervalo_dias' => 'required|integer|min:1',
        'juros' => 'required|numeric|min:0',
    ]);

    // Update the contract
    $contrato->update($request->only([
        'data_inicio', 'cliente_id', 'valor', 'qtd_parcelas', 'intervalo_dias', 'juros', 'observacao'
    ]));

    // Handle checkboxes
    $contrato->vencimento_sabado = $request->has('vencimento_sabado');
    $contrato->vencimento_domingo = $request->has('vencimento_domingo');
    $contrato->save();

    return redirect()->route('contratos.index')->with('success', 'Contrato atualizado com sucesso!');
}
    public function destroy(Contrato $contrato)
    {
        $contrato->delete();
        return redirect()->route('contratos.index');
